{
  "permissions": {
    "allow": [
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git push origin live)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck.mjs\"", "timeout": 180 },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/eslint-routes.mjs\"", "timeout": 120 }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/cadence.mjs\"", "timeout": 15 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/cadence.mjs\"", "timeout": 15 }
        ]
      }
    ]
  }
}
