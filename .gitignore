# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated prisma client — regenerated via postinstall (scripts/postinstall-prisma.mjs)
/src/generated/prisma/

# Remember plugin runtime logs
.remember/logs/

# Design atlas — screenshots are large, regenerate with: node scripts/generate-design-atlas.mjs
docs/design_atlas/screenshots/
docs/design_atlas/manifest.json
.playwright-mcp/
.gstack/

# Generated tour PDFs (Phase 1 of PDF export feature) — regenerate via: npm run pdf:tour
pdfs/

# wa-gateway service dependencies — reinstall inside services/wa-gateway.
# NOTE: dist/ (compiled output) is DELIBERATELY still tracked below, not
# ignored — see the commit that added this comment for why.
services/wa-gateway/node_modules/

# codex run artifacts
.codex-run/
