# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!src/generated/prisma
# ...but not the engine binaries for platforms this repo does not run on, nor
# the .tmp* files an interrupted `prisma generate` leaves behind. `npm ci` runs
# @prisma/client's own postinstall, which regenerates the right engine for the
# host — the VPS gets its Linux engine that way, not from git.
src/generated/prisma/query_engine-windows.dll.node
src/generated/prisma/libquery_engine-darwin-arm64.dylib.node
src/generated/prisma/*.tmp*

# Remember plugin runtime logs
.remember/logs/

# Design atlas — screenshots are large, so they stay out of git. The regenerator
# this line used to name (scripts/generate-design-atlas.mjs) does not exist and is
# not in the repo's history; docs/design_atlas/index.html is therefore a viewer
# with no way to produce its data. Verified 2026-09-02.
docs/design_atlas/screenshots/
docs/design_atlas/manifest.json
.playwright-mcp/
.superpowers/

# Claude Code local settings — machine-specific, has held real credentials before
.claude/settings.local.json
env
env.download

# scratch HTML for scripts/audit-answer-structure.py
.answer-audit/

# local file-edit backups (auto-generated before edits)
.claude/backups/

# baseline-2026-08-30 audit export: most of it is scratch, but 3 files are an
# active, verified backlog (render_chain_audit.md, conflict_register.csv,
# handoff_register.csv) — keep those tracked, ignore the rest
docs/audit/baseline-2026-08-30/*
!docs/audit/baseline-2026-08-30/render_chain_audit.md
!docs/audit/baseline-2026-08-30/conflict_register.csv
!docs/audit/baseline-2026-08-30/handoff_register.csv
